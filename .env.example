# ---------------------------------------------------------------- dominio
DOMAIN=gestione.creattivamente.it

# ---------------------------------------------------------------- Supabase (progetto in regione UE)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- motore di pianificazione
ENGINE_URL=http://localhost:8000
ENGINE_TOKEN=cambia-con-una-stringa-lunga
# secondi di calcolo per ogni bozza: più tempo, piani migliori
PLANNING_TIME_LIMIT_S=120

# ---------------------------------------------------------------- WhatsApp: Waxum self-hosted
# Nel Compose locale il DNS è waxum; per sviluppo fuori Docker usa http://localhost:3451
# Per un'istanza esterna usa il suo URL HTTPS (senza /api/v1).
WAXUM_URL=http://waxum:3451
WAXUM_TOKEN=cambia-con-token-casuale-lungo
WAXUM_JWT_SECRET=cambia-con-un-altro-segreto-casuale
WAXUM_SESSION_ID=creacloud
WAXUM_IMAGE=fdciabdul/waxum:0.16.0
# Deve essere l'URL pubblico HTTPS della dashboard, non http://web:3000.
# Waxum applica la protezione SSRF agli URL webhook.
WAXUM_WEBHOOK_URL=https://gestione.creattivamente.it/api/whatsapp/waxum
WAXUM_WEBHOOK_SECRET=cambia-con-segreto-webhook-diverso-dal-token
# false: l'AI risponde solo a chi ha già scritto. Lo staff può inviare manualmente.
ALLOW_FIRST_CONTACT=false
# Mantiene coda locale, pausa casuale e indicatore di digitazione prima degli invii.
WAXUM_PACE_SENDS=true

# ---------------------------------------------------------------- AI (Gemini)
AI_PROVIDER=gemini
# Opzione A, più semplice: chiave di Google AI Studio (piano a pagamento: i dati non vengono usati per l'addestramento)
GEMINI_API_KEY=
# Opzione B, dati in UE: Vertex AI con service account
VERTEX_PROJECT=
VERTEX_LOCATION=europe-west8
GOOGLE_SERVICE_ACCOUNT_JSON=
# modelli: veloce per i messaggi semplici, più capace per i casi dubbi
AI_MODEL_FAST=gemini-3.1-flash-lite
AI_MODEL_SMART=gemini-3-flash
# Alternativa: qualsiasi API compatibile OpenAI (AI_PROVIDER=openai-compatible)
AI_BASE_URL=
AI_API_KEY=
# millisecondi di attesa per raggruppare messaggi consecutivi
AGENT_DEBOUNCE_MS=6000
